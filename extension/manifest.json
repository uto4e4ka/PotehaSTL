{
  "manifest_version": 3,
  "name": "PotehaSTL",
  "version": "1.2.0",
  "description": "PotehaSTL: экспорт сцены three.js со страницы в GLB или STL. Оплата токенами через Telegram-бота.",
  "permissions": ["scripting", "activeTab", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PotehaSTL: экспорт сцены three.js",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
