{
  "manifest_version": 3,
  "name": "Three.js Scene → GLB / STL",
  "version": "1.1.0",
  "description": "Экспортирует текущую сцену three.js со страницы в GLB или STL.",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_title": "Экспортировать сцену three.js",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
